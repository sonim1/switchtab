# Copy this file to the ignored .env.release.local and replace the placeholders.
SPARKLE_PUBLIC_ED_KEY='your-sparkle-public-ed-key'
DEVELOPER_ID_APPLICATION='Developer ID Application: Your Name (TEAMID)'
NOTARYTOOL_KEYCHAIN_PROFILE='switchtab-notary'
SPARKLE_KEY_ACCOUNT='ed25519'
R2_BUCKET_NAME='switchtab-updates'
UPDATE_DOMAIN='updates.switchtab.app'
CLOUDFLARE_ACCOUNT_ID='your-cloudflare-account-id'
CLOUDFLARE_ZONE_ID='your-cloudflare-zone-id'

# Secrets: use scoped credentials and never commit real values.
CLOUDFLARE_API_TOKEN='your-scoped-cloudflare-api-token'
R2_ACCESS_KEY_ID='your-r2-access-key-id'
R2_SECRET_ACCESS_KEY='your-r2-secret-access-key'
